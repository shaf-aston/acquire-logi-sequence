# ──────────────────────────────────────────────────────────────────────────
# OCR PROVIDER — the switch
# ──────────────────────────────────────────────────────────────────────────
# Pick which OCR engine runs. To switch providers later:
#   1) set OCR_PROVIDER below to the new engine's key (e.g. "textract")
#   2) fill that engine's own keys in its section further down
#   3) register the engine once in src/lib/ocr/extractor.factory.ts
# Nothing else changes — the rest of the app only depends on OCR_PROVIDER.
# Registered: mistral (production, fast, structured tables) | tesseract (dev, free, local)
OCR_PROVIDER=mistral

# ── Provider: mistral ───────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ── Provider: tesseract (free local OCR — reconstructs tables for free) ─────
# No key needed. Tables are rebuilt from word coordinates (see knobs below).
TESSERACT_LANG=eng
# Render upscale before OCR — higher = sharper = better accuracy, slower (2 is good).
TESSERACT_SCALE=2
# Table reconstruction tuning (only touch if tables come out misaligned):
# Drop low-confidence OCR words (0–100).
TESSERACT_MIN_CONFIDENCE=40
# New row when vertical gap > factor × median word height.
TESSERACT_ROW_GAP_FACTOR=0.6
# New column when horizontal gap > factor × median word height.
TESSERACT_COL_GAP_FACTOR=1.2
# Min words in a row / min rows in a block to treat it as a table.
TESSERACT_MIN_COLUMNS=2
TESSERACT_MIN_TABLE_ROWS=2

# ──────────────────────────────────────────────────────────────────────────
# Shared OCR knobs (apply to whichever provider is active)
# ──────────────────────────────────────────────────────────────────────────
# Per-request hard timeout for the OCR call
OCR_TIMEOUT_MS=120000
# Retries on transient failures (network / 429 / 5xx)
OCR_MAX_RETRIES=2
OCR_RETRY_BASE_DELAY_MS=500
# Pull image crops back from OCR (heavier payload — keep off for speed)
OCR_INCLUDE_IMAGES=false

# ──────────────────────────────────────────────────────────────────────────
# Ingestion guardrails (trust-boundary validation)
# ──────────────────────────────────────────────────────────────────────────
# 25 MiB
INGEST_MAX_FILE_BYTES=26214400
INGEST_ALLOWED_MIME=application/pdf

# ──────────────────────────────────────────────────────────────────────────
# Address extraction from the quotation (pickup + delivery drops)
# ──────────────────────────────────────────────────────────────────────────
# rule = label + postcode regex detector (fast, free, no key). Set to "groq" to
# read the whole page with an LLM instead — far better on messy real quotation
# layouts (merged lines, table columns, stray labels). Uses its OWN Groq key,
# separate from the durability classifier's, so the two can be rotated apart.
# On any failure the groq engine degrades to the rule detector — it never breaks ingestion.
ADDRESS_EXTRACTOR_PROVIDER=rule
ADDRESS_GROQ_API_KEY=
# Required when the groq provider is active (no default → fails loud to rule fallback).
ADDRESS_GROQ_MODEL=
ADDRESS_GROQ_BASE_URL=https://api.groq.com/openai/v1
ADDRESS_GROQ_TIMEOUT_MS=30000
ADDRESS_GROQ_MAX_RETRIES=2
ADDRESS_GROQ_RETRY_BASE_DELAY_MS=500
# Cap on the document text sent to the LLM (bounds token cost; over-long docs are truncated).
ADDRESS_GROQ_MAX_INPUT_CHARS=20000

# ──────────────────────────────────────────────────────────────────────────
# Fragility classification (Stage 2)
# ──────────────────────────────────────────────────────────────────────────
# rule = keyword/material ruleset (fast, free). Swappable for an LLM engine later.
CLASSIFIER_PROVIDER=rule
# Path (relative to project root) to the editable fragility ruleset.
FRAGILITY_RULES_PATH=config/fragility-rules.json

# ──────────────────────────────────────────────────────────────────────────
# Durability / stacking classification (Stage 3)
# ──────────────────────────────────────────────────────────────────────────
# rule = keyword/material ruleset (fast, free, no key needed). "groq" = LLM
# primary — one batched call per unique material value (see
# docs/stacking-item-data.md); SambaNova auto-backs it up when its key+model
# are configured below (and becomes primary itself if Groq's key/model are left
# blank). "sambanova" = SambaNova primary directly, rule classifier still the
# last resort either way.
DURABILITY_CLASSIFIER_PROVIDER=rule
# Path (relative to project root) to the editable durability ruleset / tier config.
DURABILITY_RULES_PATH=config/durability-rules.json
DURABILITY_TIERS_PATH=config/durability-tiers.json

# ── Provider: groq (only used when DURABILITY_CLASSIFIER_PROVIDER=groq) ────
GROQ_API_KEY=
# Required when the groq provider is active — no default, so a missing model
# fails loud instead of silently calling an unintended one.
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2
GROQ_RETRY_BASE_DELAY_MS=500
# Unique materials per request; a manifest with more unique values chunks into
# further sequential (never parallel) calls instead of one giant request.
GROQ_MAX_ITEMS_PER_CALL=60

# ── Backup provider: SambaNova (OpenAI-compatible) ─────────────────────────
# Auto-tried when Groq fails, before the rule classifier. Inert unless key+model
# are set. Reuses the GROQ_* timeout/retry/chunk knobs above — only the endpoint differs.
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# ──────────────────────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# true = human-readable, false = JSON lines
LOG_PRETTY=true
PERF_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────
# Stage 5 — Routing + Pricing
# ──────────────────────────────────────────────────────────────────────────
# Google Maps Routes API v2 — server-side only, never prefix NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# Google Maps JavaScript API — the LIVE MAP in the browser (Depots & hubs screen).
# This one IS exposed to the browser (NEXT_PUBLIC_), so it MUST be a SEPARATE key from the
# server key above, locked down in Google Cloud to be safe to publish:
#   1. Create a new API key. 2. Application restriction: "Websites" → add your site's URL(s)
#      (and http://localhost:3000/* for local dev). 3. API restriction: enable ONLY
#      "Maps JavaScript API". Never give this key the billed Routes/Geocoding APIs.
# Leave blank to disable the live map — the hubs screen still works (shows a placeholder and
# the nearest-hub search keeps running on the free OpenStreetMap lookup).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Per-request timeout for routing API calls (ms).
MAPS_TIMEOUT_MS=10000
# Surcharge applied per fragile item (£).
FRAGILITY_SURCHARGE_PER_ITEM=5
# Distance multiplier billed to the customer: 1.0 = one-way, 2.0 = full round trip
# (the van drives back to base empty). Scales billed miles only — reported one-way
# distance is unchanged.
ROUTE_RETURN_FACTOR=2

# ──────────────────────────────────────────────────────────────────────────
# Object storage — archives the source PDF + structured doc
# ──────────────────────────────────────────────────────────────────────────
# OFF by default: the app runs fine without it (uploads are processed in-memory).
# When enabled, each ingest stores raw/<sha256>.pdf and documents/<sha256>.json,
# content-addressed so re-uploads are idempotent.
#
# Two backends, picked automatically:
#   • LOCAL (default) — set STORAGE_ENABLED=true and nothing else. Files land on
#     disk under STORAGE_DIR. No cloud account, no credentials.
#   • R2 (cloud)      — also fill the four R2_* vars below and it switches to
#     Cloudflare R2 (S3 API). Server-side only — never prefix with NEXT_PUBLIC_.
STORAGE_ENABLED=false
STORAGE_DIR=data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ──────────────────────────────────────────────────────────────────────────
# Send Quote — outbound email
# ──────────────────────────────────────────────────────────────────────────
# Only SMTP is registered today (see src/lib/email/email.factory.ts). Default
# host/port/secure below are Gmail's. EMAIL_SMTP_PASS is unset by default — until
# it's filled in, Send Quote fails loud (never a silent no-op) so an operator is
# never told a quote went out when it didn't.
#
# Gmail setup: enable 2-Step Verification on the sending account, then generate
# an App Password (myaccount.google.com > Security > App passwords) and paste it
# below. EMAIL_SMTP_USER must be the same mailbox as EMAIL_FROM_ADDRESS.
EMAIL_FROM_ADDRESS=
# Optional display name, e.g. "Cargo Express Quotes" — blank sends as the bare address.
EMAIL_FROM_NAME=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# true = implicit TLS (port 465). false = STARTTLS (port 587, Gmail's default).
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_TIMEOUT_MS=15000
# Blank = no copy. Set to always BCC one address (e.g. the sender's own inbox) on
# every quote sent — a paper trail that stays invisible to the client.
EMAIL_BCC=

# ──────────────────────────────────────────────────────────────────────────
# Admin config writes (fleet + hub network)
# ──────────────────────────────────────────────────────────────────────────
# Shared secret required (x-admin-key header) to add/edit/remove hubs or vans.
# Blank = those writes are REFUSED (safe default). Reading config is unaffected.
# The browser asks the operator for it once per tab — it is never put in client code.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=
